# Optional locally. Production uses the Render Key Value connection string.
REDIS_URL=redis://localhost:6379

RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_DISABLED=false

SOURCE_ROADS_ENABLED=true
SOURCE_BRIDGES_ENABLED=true
SOURCE_CAMERAS_ENABLED=true
SOURCE_BUS_ENABLED=true
SOURCE_PARKING_ENABLED=true
SOURCE_WEATHER_ENABLED=true
SOURCE_NOTICES_ENABLED=true
SOURCE_LRT_ENABLED=true
SOURCE_BORDERS_ENABLED=true

# AI learning assistant. Any OpenAI-compatible chat completions endpoint works.
# Defaults point at DeepSeek; set base URL and model for another provider.
SOURCE_ASSISTANT_ENABLED=true
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=https://api.deepseek.com/v1
ASSISTANT_MODEL=deepseek-chat
ASSISTANT_RATE_LIMIT_PER_MINUTE=12
# Local models can be slower: point the base URL at an OpenAI-compatible
# server such as http://127.0.0.1:11434/v1 and raise this timeout.
ASSISTANT_TIMEOUT_MS=25000
